# Copy this file to .env and change what you need. Everything is optional.
# Never commit .env: it can hold your database password.

# Port and address to listen on. Use HOST=0.0.0.0 when other machines need to reach it.
# (On Render both are set for you.)
PORT=8080
HOST=127.0.0.1

# This Ater account gets the broadcaster badge. Leave empty and the first account created gets it,
# so set it before the site is public.
ATER_OWNER=

# MongoDB (Atlas works). Without it, everything is saved to ATER_DATA instead.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ater

# Where to save when there's no MongoDB.
ATER_DATA=data/ater-data.json

# The public address, e.g. https://ater-live.onrender.com (Render sets RENDER_EXTERNAL_URL for you).
PUBLIC_URL=

# Set to 1 behind a reverse proxy (nginx, Caddy, Cloudflare) so rate limits see real visitor IPs.
# (Automatic on Render.)
TRUST_PROXY=0
