# Copy this file to .env and change what you need. Everything is optional.

# Port and address to listen on. Use HOST=0.0.0.0 when other machines need to reach it.
PORT=8080
HOST=127.0.0.1

# This Ater account gets the broadcaster badge. Leave empty and the first account created gets it.
ATER_OWNER=

# Where accounts, sessions and chat history are saved.
ATER_DATA=data/ater-data.json

# Set to 1 behind a reverse proxy (nginx, Caddy, Cloudflare) so rate limits see real visitor IPs.
TRUST_PROXY=0
